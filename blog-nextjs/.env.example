# ============================================
# 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 填写实际的配置值
# 3. .env.local 不会被提交到 Git
# ============================================

# ============================================
# Notion CMS 配置（必需）
# ============================================

# Notion Integration Token
# 获取方式：https://www.notion.so/my-integrations
# 格式：secret_xxxxxxxxxxxxxxxxxxxxx
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxx-xxx-xxx

# ============================================
# 网站基础信息（必需）
# ============================================

# 网站 URL（生产环境）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 网站标题
NEXT_PUBLIC_SITE_TITLE=空间超算精选

# 网站描述
NEXT_PUBLIC_SITE_DESCRIPTION=分享加密货币、股市投资、个人成长的见解

# ============================================
# Giscus 评论配置（必需）
# ============================================

# GitHub 仓库（格式：owner/repo）
NEXT_PUBLIC_GISCUS_REPO=username/repo

# 仓库 ID（获取方式：https://giscus.app/zh-CN）
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxx

# Discussion 分类名称
NEXT_PUBLIC_GISCUS_CATEGORY=General

# 分类 ID
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxx

# ============================================
# Supabase 配置（可选 - 金融功能）
# ============================================

# Supabase 项目 URL
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Supabase Anon Key（公开密钥）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Supabase Service Role Key（私密密钥）
# ⚠️ 警告：此密钥拥有完全权限，只能用于服务端
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ============================================
# Vercel Cron Jobs 配置（可选 - 金融功能）
# ============================================

# Cron Job 安全密钥
# 生成方式：openssl rand -base64 32
CRON_SECRET=your-random-secret-string

# ============================================
# Google Analytics（可选）
# ============================================

# Google Analytics Measurement ID
# 格式：G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Sentry 错误监控（可选）
# ============================================

# Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxx

# ============================================
# 注意事项
# ============================================

# 1. 环境变量分类：
#    - NEXT_PUBLIC_* : 暴露给客户端（浏览器可访问）
#    - 其他：仅服务端可访问
#
# 2. 安全警告：
#    - 不要将 SUPABASE_SERVICE_ROLE_KEY 暴露给客户端
#    - 不要将此文件提交到 Git
#    - 生产环境在 Vercel Dashboard 中配置环境变量
#
# 3. 最低要求：
#    必需配置：
#    - NOTION_TOKEN
#    - NOTION_DATABASE_ID
#    - NEXT_PUBLIC_SITE_URL
#    - NEXT_PUBLIC_SITE_TITLE
#    - NEXT_PUBLIC_GISCUS_* (4 个)
#
#    可选配置：
#    - NEXT_PUBLIC_SUPABASE_* (金融功能)
#    - CRON_SECRET (金融功能)
#    - NEXT_PUBLIC_GA_MEASUREMENT_ID (分析)
#    - SENTRY_* (错误监控)

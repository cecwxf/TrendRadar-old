# LLM 排行榜配置

# 数据源选择: "openrouter" | "hybrid" | "huggingface" | "mock"
LLM_DATA_SOURCE=hybrid

# HuggingFace 配置
HF_API_BASE=https://huggingface.co/api
HF_MODEL_LIMIT=50
HF_FILTER=text-generation
HF_SORT_BY=downloads
# HF_API_TOKEN=your_huggingface_token_here  # 可选，用于提高速率限制

# OpenRouter 配置（支持闭源模型）
OR_API_BASE=https://openrouter.ai/api/v1
OR_MODEL_LIMIT=60
OR_CATEGORIES=general,programming,multimodal
OR_PINNED_KEYWORDS=gemini,claude,gpt,glm,kimi
# OPENROUTER_API_KEY=your_openrouter_api_key_here  # 可选

# 混合模式配置
LLM_HYBRID_MODEL_LIMIT=80

# 缓存配置
LLM_CACHE_TTL=3600        # 缓存时间（秒）
LLM_CACHE_SWR=7200        # stale-while-revalidate 时间（秒）

# 趋势数据配置
LLM_TRENDS_DAYS=30        # 历史天数
LLM_TRENDS_TOP_N=10       # Top N 模型

# 分类配置
LLM_CATEGORIES_ENABLED=true

# 市场份额配置
LLM_MARKET_SHARE_ENABLED=true
LLM_MIN_SHARE_PERCENT=1.0
